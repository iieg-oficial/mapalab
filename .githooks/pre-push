#!/bin/sh
# Load nvm if available so hooks run con el Node del proyecto (.nvmrc) en shells no interactivos
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh" --no-use
    nvm use --silent >/dev/null 2>&1 || nvm use default --silent >/dev/null 2>&1 || true
fi

cd frontend || exit 1
npm run lint || exit 1
npm run test:coverage || exit 1
npm run check:dead-code:strict || exit 1
