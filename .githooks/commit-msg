#!/bin/bash

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

regex="^(build|chore|ci|docs|feat|fix|merge|perf|refactor|revert|style|test)(\([a-z0-9\-]+\))?: .+"

if echo "$commit_msg" | grep -q "^Merge branch"; then
  exit 0
fi

if [[ ! "$commit_msg" =~ $regex ]]; then
  echo ""
  echo "❌ Error: El mensaje del commit no sigue el estandar de Conventional Commits."
  echo "El formato debe ser: <tipo>[(ambito opcional)]: <descripcion>"
  echo ""
  echo "Tipos validos: build, chore, ci, docs, feat, fix, merge, perf, refactor, revert, style, test"
  echo "Ambitos comunes (opcional): auth, map, ui, backend, frontend, db, api, etc."
  echo ""
  echo "Ejemplo valido sin ambito: feat: add login form"
  echo "Ejemplo valido con ambito: feat(auth): add login form"
  echo "Tu mensaje fue: '$commit_msg'"
  echo ""
  exit 1
fi

exit 0
