/* Generado por mariachi desde el modulo Identidad. No editar a mano. */

/* Se aplica sobre el widget raiz del consumidor, no sobre la aplicacion.
   Solo define marca: familia, acentos, radios y espaciados.
   Fondos y texto base se dejan al tema del anfitrion salvo donde
   la identidad lo exige, para no romper el modo oscuro. */

/* Fuentes de la marca (descargar y registrar en el cliente):
   Garet 400: https://iieg.jalisco.gob.mx/acervo/iieg/tipografia/garet-book.otf
*/

* {
    font-family: "Garet", "system-ui", "sans-serif";
    font-size: 16px;
}

/* Pildora, como los botones del visor. El radio se acota a la mitad
   del alto: Qt no interpreta un 9999px como CSS y deja la esquina recta. */
QPushButton[brandRole="primary"] {
    background-color: #5C2472;
    color: #FFFFFF;
    border-radius: 19px;
    padding: 8px 12px;
    border: 1px solid #5C2472;
}

QPushButton[brandRole="primary"]:disabled {
    background-color: palette(mid);
    color: palette(disabled-text);
}

/* Seleccion: superficie clara del acento con el acento oscuro en el
   texto (4.86:1). El acento base da 2.09:1 sobre ese fondo. El lado
   izquierdo va sin radio para que empalme con la rama teñida. */
QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: #FFE9CC;
    color: #9E5200;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

QLineEdit:focus {
    border: 1px solid #5C2472;
}

QLineEdit {
    border-radius: 4px;
    padding: 8px;
    border: 1px solid palette(mid);
}

QTreeView, QTreeWidget {
    background-color: #FFFFFF;
    border-radius: 16px;
}

QWidget[brandRole="panel"] {
    background-color: #FFFFFF;
}

/* Campo de busqueda: misma superficie, radio y color de texto que
   el buscador del visor, sin borde y con el foco en el primario. */
QLineEdit[brandRole="search"] {
    background-color: #EAEFFA;
    color: #5C2472;
    border: none;
    border-radius: 16px;
    padding: 12px 12px;
}

QLineEdit[brandRole="search"]:focus {
    border: 1px solid #703088;
}

QPushButton[brandRole="secondary"] {
    background-color: transparent;
    color: #5C2472;
    border: 1px solid #5C2472;
    border-radius: 19px;
    padding: 8px 12px;
}

QPushButton[brandRole="secondary"]:hover {
    background-color: #5C2472;
    color: #FFFFFF;
}

/* Mismo sangrado horizontal que primary y secondary, para que los
   tres textos arranquen en la misma linea vertical. */
QPushButton[brandRole="quiet"] {
    background-color: transparent;
    color: #465055;
    border: none;
    text-align: left;
    padding: 8px 12px;
}

QPushButton[brandRole="quiet"]:hover {
    color: #5C2472;
    text-decoration: underline;
}

QTreeView, QTreeWidget {
    border: none;
    outline: none;
    show-decoration-selected: 1;
}

QWidget[brandRole="card"] {
    border-radius: 8px;
    border: 1px solid palette(mid);
    padding: 8px;
}

/* Sin borde ni outline: el estilo nativo dibuja su propio realce
   azul encima del hover si no se anulan los dos. */
QTreeView::item, QTreeWidget::item {
    padding: 2px 0px;
    border-radius: 4px;
    border: none;
    outline: none;
}

QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: rgba(70, 80, 85, 0.08);
    color: palette(text);
    border: none;
    outline: none;
}

/* La rama hereda el azul nativo si no se tine: la seleccion se
   veria partida entre la sangria y el texto. */
QTreeView::branch:selected, QTreeWidget::branch:selected {
    background-color: #FFE9CC;
}

QTreeView::branch:hover, QTreeWidget::branch:hover {
    background-color: rgba(70, 80, 85, 0.08);
}

QLabel[brandRole="title"] {
    color: #5C2472;
    font-size: 18px;
    font-weight: 700;
    padding: 8px 0px;
}

QLabel[brandRole="heading"] {
    color: #2e4372;
    font-size: 18px;
    font-weight: 600;
}

/* El acento no cumple contraste AA como texto: solo fondo. */
QLabel[brandRole="badge"] {
    background-color: #FF8300;
    color: #465055;
    border-radius: 8px;
    padding: 1px 8px;
    font-size: 14px;
}
