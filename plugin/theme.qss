/* Generado por mariachi desde el modulo Identidad. No editar a mano. */

/* Se aplica sobre el widget raiz del consumidor, no sobre la aplicacion.
   Solo define marca: familia, acentos, radios y espaciados.
   Fondos y texto base se dejan al tema del anfitrion salvo donde
   la identidad lo exige, para no romper el modo oscuro. */

/* Fuentes de la marca (descargar y registrar en el cliente):
   Garet 400: https://iieg.jalisco.gob.mx/acervo/iieg/tipografia/garet-book.otf
   Garet 700: https://iieg.jalisco.gob.mx/acervo/iieg/tipografia/garet-bold.otf
*/

* {
    font-family: "Garet", "system-ui", "sans-serif";
    font-size: 16px;
}

QPushButton[brandRole="primary"] {
    background-color: #5C2472;
    color: #FFFFFF;
    border-radius: 4px;
    padding: 8px 12px;
    border: none;
}

QPushButton[brandRole="primary"]:disabled {
    background-color: palette(mid);
    color: palette(disabled-text);
}

QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: #5C2472;
    color: #FFFFFF;
}

QLineEdit:focus {
    border: 1px solid #5C2472;
}

QLineEdit {
    border-radius: 4px;
    padding: 8px;
    border: 1px solid palette(mid);
}

QPushButton[brandRole="secondary"] {
    background-color: transparent;
    color: #5C2472;
    border: 1px solid #5C2472;
    border-radius: 4px;
    padding: 8px 12px;
}

QPushButton[brandRole="secondary"]:hover {
    background-color: #5C2472;
    color: #FFFFFF;
}

/* Mismo sangrado horizontal que primary y secondary, para que los
   tres textos arranquen en la misma linea vertical. */
QPushButton[brandRole="quiet"] {
    background-color: transparent;
    color: #465055;
    border: none;
    text-align: left;
    padding: 8px 12px;
}

QPushButton[brandRole="quiet"]:hover {
    color: #5C2472;
    text-decoration: underline;
}

QTreeView, QTreeWidget {
    border: none;
    show-decoration-selected: 1;
}

QTreeView::item, QTreeWidget::item {
    padding: 2px 0px;
    border-radius: 4px;
}

QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: rgba(92, 36, 114, 0.1);
    color: palette(text);
}

/* La rama hereda el azul nativo si no se tine: la seleccion se
   veria partida entre la sangria y el texto. */
QTreeView::branch:selected, QTreeWidget::branch:selected {
    background-color: #5C2472;
}

QTreeView::branch:hover, QTreeWidget::branch:hover {
    background-color: rgba(92, 36, 114, 0.1);
}

QLabel[brandRole="title"] {
    color: #5C2472;
    font-size: 18px;
    font-weight: 700;
    padding: 8px 0px;
}

QLabel[brandRole="heading"] {
    color: #2e4372;
    font-size: 18px;
    font-weight: 600;
}

/* El acento no cumple contraste AA como texto: solo fondo. */
QLabel[brandRole="badge"] {
    background-color: #FF8300;
    color: #465055;
    border-radius: 8px;
    padding: 1px 8px;
    font-size: 14px;
}
