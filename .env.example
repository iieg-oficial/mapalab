# Copia este archivo segun tu entorno:
#   cp .env.example .env.development  
#   cp .env.example .env.staging      
#   cp .env.example .env.production   

# General
NETWORK_NAME=<name_network>

# Frontend
VITE_PORT=<port>
FRONTEND_PORT=<port>
VITE_BACKEND_API_HOST=<path>
VITE_GEOSERVER_URL=<path>
VITE_ACERVO_ORIGIN=<http://acervo_host:port>
VITE_BASE_PATH=<path>
VITE_SITE_URL=<http://localhost:<port>|https://dominio>
VITE_NODE_ENV=<development|production>
VITE_APP_ENV=<dev|beta>
VITE_COLIBRI_SOURCE_APP=mapalab
VITE_COLIBRI_API_KEY=<ck_pub_... — generar en /colibri/source-apps del panel admin de Colibri>

# Sentry (opcional — si VITE_SENTRY_DSN esta vacio, Sentry no se inicializa)
# SENTRY_* (sin prefijo VITE_) solo se usan en build de CI para subir sourcemaps
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://sentry.io/

GEOSERVER_DEV_TARGET=http://ip:port
BACKEND_DEV_TARGET=http://ip:port
MARIACHI_DEV_TARGET=http://ip:port


# Backend
ENVIRONMENT=<development|production>
DEBUG=<True|False>
CORS_ORIGINS=["domino,ip"]
LOG_LEVEL=<DEBUG|INFO>
BACKEND_PORT=<port>
BACKEND_TARGET=<development|production>

GEOSERVER_URL=<http://localhost:port/geoserver/|http://ip:port/geoserver/>
GEOSERVER_USER=<YOUR_GEOSERVER_USER>
GEOSERVER_PASSWORD=<YOUR_GEOSERVER_PASSWORD>

DB_USER=<YOUR_DB_USER>
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_HOST=<localhost|ip>
DB_PORT=<port>
DB_NAME=<YOUR_DB_NAME>

ACERVO_PUBLIC_URL=https://<APP_DOMAIN>/path

# Token compartido con mariachi-api para autorizar shares permanentes (debe coincidir)
MAPALAB_INTERNAL_TOKEN=<genera_con_secrets.token_urlsafe(32)>

# Sentry backend (opcional — si vacio no se inicializa)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Performance (ajustar segun recursos del servidor)
# GCP staging (2 cores): GUNICORN_WORKERS=4, DB_POOL_SIZE=4, DB_MAX_OVERFLOW=4
# Production  (4 cores): GUNICORN_WORKERS=8, DB_POOL_SIZE=8, DB_MAX_OVERFLOW=8
GUNICORN_WORKERS=8
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=8

# Nginx
NGINX_PORT=<port>
