########################################
# ARCHIVO DE CONFIGURACIÓN PARA PRODUCCIÓN
# Usado por docker-compose
# Copia este archivo como .env y ajusta los valores
########################################

########################################
# BUILD VARIABLES
########################################

# Google Analytics ID (requerido para el build)
# Ejemplo: G-XXXXXXXXXX
VITE_GOOGLE_ANALYTICS_ID=<id_analytics>

########################################
# RUNTIME VARIABLES - PROXY NGINX
########################################

# URL del backend API para proxy inverso
# IMPORTANTE: Debe incluir el trailing slash si es necesario
# Ejemplo: http://backend-server:8000/api/v1/
# Ejemplo: http://localhost/api/
VITE_BACKEND_API_HOST=http://localhost/api/

# URL del GeoServer para proxy inverso
# IMPORTANTE: Debe incluir /geoserver/ y el trailing slash
# Ejemplo: http://geoserver:8080/geoserver/
# Ejemplo: http://localhost/geoserver/
VITE_GEOSERVER_URL=http://localhost/geoserver/

########################################
# NOTAS
########################################
# - Las rutas proxy en nginx son:
#   Frontend -> /api/mapalab/ -> ${VITE_BACKEND_API_HOST}
#   Frontend -> /api/geoserver/ -> ${GEOSERVER_URL}
#
# - Para usar estas variables:
#   1. Copia este archivo: cp .env.example .env
#   2. Edita .env con tus valores reales
#   3. Ejecuta: docker-compose up --build
