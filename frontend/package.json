{
    "name": "mapalab",
    "description": "Interfaz web para Mapa Lab del Instituto de Información Estadística y Geográfica de Jalisco.",
    "license": "MIT",
    "author": "Edgar Alejandro Villarreal Padilla <edgar.villarreal@iieg.gob.mx>",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "cd .. && git config core.hooksPath .githooks 2>/dev/null || true",
