{
    "name": "mapalab",
    "description": "Mapa interactivo de Jalisco con capas geoespaciales. La herramienta oficial para visualizar y analizar informaci\u00f3n territorial del estado.",
    "license": "MIT",
    "author": "Edgar Alejandro Villarreal Padilla <edgar.villarreal@iieg.gob.mx>",
    "version": "1.40.1",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "cd .. && git config core.hooksPath .githooks 2>/dev/null || true",
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest --run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --run --coverage",
        "check:dead-code": "knip --no-exit-code",
        "check:dead-code:strict": "knip"
    },
    "lint-staged": {
        "*.{js,jsx}": "eslint --max-warnings=0 --no-warn-ignored"
    },
    "dependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/modifiers": "9.0.0",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@sentry/react": "^10.49.0",
        "@tailwindcss/vite": "4.2.4",
        "html2canvas-pro": "1.5.11",
        "jspdf": "4.2.1",
        "jszip": "3.10.1",
        "lottie-react": "2.4.1",
        "ol": "10.9.0",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-router": "7.14.2",
        "tailwindcss": "4.2.2",
        "web-vitals": "^5.2.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@sentry/vite-plugin": "^5.2.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.2.0",
        "@vitest/coverage-v8": "4.1.5",
        "@vitest/ui": "4.1.5",
        "eslint": "10.2.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.2",
        "globals": "17.4.0",
        "happy-dom": "^20.9.0",
        "knip": "^6.6.0",
        "lint-staged": "^16.4.0",
        "rollup-plugin-visualizer": "^7.0.1",
        "vite": "7.3.2",
        "vitest": "4.1.5"
    },
    "overrides": {
        "eslint-plugin-react-hooks": {
            "eslint": "$eslint"
        },
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    }
}
