########################################
# ARCHIVO DE CONFIGURACIÓN PARA DESARROLLO LOCAL
# Usado por npm run dev (Vite)
# Copia este archivo como .env.development y ajusta los valores
########################################

########################################
# FRONTEND - URLs de APIs externas
########################################

# URL base de la API del backend (OBLIGATORIA)
# En desarrollo local, apunta directamente al backend
# Ejemplo: http://localhost:8000/
VITE_BACKEND_API_HOST=http://localhost:8000/


# URL del servidor GeoServer para capas geoespaciales (OBLIGATORIA)
# En desarrollo local, apunta directamente al GeoServer
# Ejemplo: http://localhost:8080/geoserver/
VITE_GEOSERVER_URL=http://localhost:8080/geoserver/

# Modo de entorno (opcional)
# Valores: development | production | test
VITE_NODE_ENV=development

# Puerto del servidor de desarrollo Vite (opcional)
# Ejemplo: 3000, 3001, 3006
VITE_PORT=3000

# Puerto expuesto por Docker para el frontend
FRONTEND_PORT=5173

# Nombre de la red Docker
NETWORK_NAME=mapalab-network

########################################
# VERSIÓN Y SERVICIOS EXTERNOS
########################################

# Versión de la aplicación (opcional)
VERSION=0.0.0

# Google reCaptcha v3 (opcional)
# Obtén tu clave en: https://www.google.com/recaptcha/admin
VITE_GOOGLE_RECAPTCHA_SITE_KEY=<clave_recaptcha>

# Google Analytics 4 (opcional)
# Obtén tu ID en: https://analytics.google.com/
# Ejemplo: G-XXXXXXXXXX
VITE_GOOGLE_ANALYTICS_ID=<id_analytics>

# URL base del sitio en producción (usada para canonical, og:url y sitemap)
# Ejemplo: https://iieg.jalisco.gob.mx/mapalab
VITE_SITE_URL=http://localhost:3006

########################################
# NOTAS PARA DESARROLLO
########################################
# - En desarrollo, el frontend se ejecuta con: npm run dev
# - Todas las variables VITE_* son inyectadas en build time
# - El puerto por defecto de Vite es 5173, pero puedes cambiarlo con VITE_PORT
# - Para usar estas variables:
#   1. Copia este archivo: cp .env.development.example .env.development
#   2. Edita .env.development con tus valores reales
#   3. Ejecuta: npm run dev
