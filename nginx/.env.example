# Nginx Configuration
# Copy this file to .env and adjust the values

# External port for nginx
NGINX_PORT=80

# GeoServer configuration (external service)
# Replace with your actual GeoServer host and port
GEOSERVER_HOST=localhost
GEOSERVER_PORT=8080

# Examples:
# Development (local GeoServer):
# GEOSERVER_HOST=localhost
# GEOSERVER_PORT=8080

# Production (remote GeoServer):
# GEOSERVER_HOST=10.13.23.58
# GEOSERVER_PORT=8080
